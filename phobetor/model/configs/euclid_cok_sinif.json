{
 "_aciklama": "Euclid Q1 (euclid_v1): yildiz, galaksi ve kuasar bulma ve siniflama; galaksilerde uzaklik, kutle, yildiz olusumu, boyut, sekil ve Galaxy Zoo bicim oylari. Butun etiketler resmi Euclid kataloglarindan (etiketler/ ve etiketler_ek/).",
 "bands": ["SCI_VIS", "SCI_Y", "SCI_J", "SCI_H"],
 "noise": ["RMS_VIS", "RMS_Y", "RMS_J", "RMS_H"],
 "noise_kind": "rms",
 "flag_hdu": "FLAG_VIS",
 "flag_mask": 6950958,
 "image_glob": "{split}/goruntuler/*.fits",
 "label_path": "{split}/etiketler/{name}.csv",
 "extra_label_path": "{split}/etiketler_ek/{name}.csv",
 "x_col": "x",
 "y_col": "y",
 "mag_col": "mag_vis",
 "classes": [
  {"ad": "yildiz", "query": "sinif == 'yildiz' and vis_det == 1", "match_radius_px": 2.0},
  {"ad": "galaksi", "query": "sinif == 'galaksi' and vis_det == 1 and gaia_id.isna()", "match_radius_px": 3.0},
  {"ad": "kuasar", "query": "sinif == 'kuasar' and vis_det == 1 and gaia_id.isna()", "match_radius_px": 2.0}
 ],
 "class_weights": [1.0, 1.0, 1.0],
 "ignore": "sinif == 'belirsiz' or vis_det == 0 or (sinif != 'yildiz' and gaia_id.notna())",
 "_ignore_notu": "Belirsiz siniflar, sadece kizilotesinde tespit edilenler ve Gaia eslesmesi olup PHZ'nin yildiz demedigi kaynaklar (cogu doymus parlak yildiz) yok sayilir. 'sahte' isaretli kaynaklar hicbir sinif degildir: ag orada bir sey bulmamali.",
 "props": [
  {"ad": "uzaklik_z", "col": "z_foto", "tf": "log1p", "classes": ["galaksi"], "range": [0.01, 6.0], "query": "fizik_kalite == 0"},
  {"ad": "log_kutle", "col": "log_kutle", "classes": ["galaksi"], "range": [5.0, 13.0], "query": "fizik_kalite == 0"},
  {"ad": "log_yildiz_olusumu", "col": "log_sfr", "classes": ["galaksi"], "range": [-5.0, 4.0], "query": "fizik_kalite == 0"},
  {"ad": "yaricap_yaysn", "col": "sersic_yaricap", "tf": "log10", "classes": ["galaksi"], "range": [0.02, 20.0], "query": "mag_vis < 24"},
  {"ad": "sersic_indeks", "col": "sersic_indeks", "tf": "log10", "classes": ["galaksi"], "range": [0.3, 5.5], "query": "mag_vis < 24"},
  {"ad": "eksen_orani", "col": "eksen_orani", "classes": ["galaksi"], "range": [0.03, 1.0], "query": "mag_vis < 24"},
  {"ad": "gz_sarmal", "col": "gz_sarmal_evet", "kind": "frac", "scale": 0.01, "classes": ["galaksi"], "range": [0, 1]},
  {"ad": "gz_puruzsuz", "col": "gz_puruzsuz", "kind": "frac", "scale": 0.01, "classes": ["galaksi"], "range": [0, 1]},
  {"ad": "gz_birlesme", "col": "gz_birlesme", "kind": "frac", "scale": 0.01, "classes": ["galaksi"], "range": [0, 1]},
  {"ad": "gz_yandan", "col": "gz_yandan_evet", "kind": "frac", "scale": 0.01, "classes": ["galaksi"], "range": [0, 1]},
  {"ad": "kuasar_z", "col": "kuasar_z", "tf": "log1p", "classes": ["kuasar"], "range": [0.01, 7.0]}
 ],
 "stretch": 3.0,
 "heatmap_sigma_px": 1.0,
 "match_radius_px": 2.0,
 "ignore_radius_px": 3.0,
 "crop": 256,
 "pos_crop_prob": 0.6,
 "mag_bins": [16, 18, 20, 21, 22, 23, 24, 25, 26, 28],
 "base_channels": 32
}
